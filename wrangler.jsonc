{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker created by the Workers Builds import (it owns the
  // custom domains). Never rename.
  "name": "whenever",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // `npm run build` writes dist/ (public/ plus the bundled, hashed app and
  // stylesheet; see scripts/build.mjs). wrangler dev and a local deploy run it
  // through "build", but Workers Builds ignores that field: its Build command
  // (production and Previews Base) must be `npm run build`.
  "build": {
    "command": "node scripts/build.mjs",
    "watch_dir": ["src/app", "src/shared", "public"]
  },
  "assets": {
    "directory": "dist",
    // /e/<id> and /e/<id>/<token> get index.html; the app routes client-side.
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker; everything else is free static assets.
    "run_worker_first": ["/api/*"]
  },
  // One SQLite-backed Durable Object per event (the free plan only allows
  // SQLite-backed classes).
  // Plus one Lookup object for the whole app: the email index and its codes.
  "durable_objects": {
    "bindings": [
      { "name": "POLLS", "class_name": "Poll" },
      { "name": "LOOKUP", "class_name": "Lookup" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Poll"] },
    { "tag": "v2", "new_sqlite_classes": ["Lookup"] }
  ],
  // Per-IP throttles: LIMIT on the whole API, MAIL_LIMIT on asking for and
  // trying email codes. Namespace ids are account-wide: 1001 is scoreboard,
  // 2001/2002 are scorepad.
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "3001", "simple": { "limit": 120, "period": 60 } },
    { "name": "MAIL_LIMIT", "namespace_id": "3003", "simple": { "limit": 5, "period": 60 } }
  ],
  // Code mails a day for the whole app (kept below the Forward Email plan's
  // sending limit). SMTP_USER and SMTP_PASS are secrets, set in the dashboard.
  "vars": { "MAIL_DAILY_MAX": "200" },
  // Workers Logs for console output only (failed code mails say why there);
  // no per-request logs.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Branch builds run `wrangler preview`, which needs this block. Each Preview
  // gets its own Durable Object namespace automatically; the binding just has
  // to be declared again. Previews use their own rate-limit namespaces (3002, 3004).
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "POLLS", "class_name": "Poll" },
        { "name": "LOOKUP", "class_name": "Lookup" }
      ]
    },
    "ratelimits": [
      { "name": "LIMIT", "namespace_id": "3002", "simple": { "limit": 120, "period": 60 } },
      { "name": "MAIL_LIMIT", "namespace_id": "3004", "simple": { "limit": 5, "period": 60 } }
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "finn-tid.apphub.casa", "custom_domain": true },
    { "pattern": "whenever.apphub.casa", "custom_domain": true }
  ]
}
